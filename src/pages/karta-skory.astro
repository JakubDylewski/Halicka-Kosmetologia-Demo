---
// 15 — Karta Twojej Skóry, część 1: kreator jeden-ekran-jedno-pytanie +
// wygenerowana Karta. Cały stan (odpowiedzi, bieżący krok) trzymany w
// pamięci JS w przeglądarce — bez backendu, bez localStorage, zgodnie z 15.7.
// Formularz maila (15.5) i sekcja na stronie głównej (15.6) to część 2.
import Layout from "../layouts/Layout.astro";
import { quizQuestions } from "../data/skinQuiz";

const totalQuestions = quizQuestions.length;
const resultStep = totalQuestions + 1;

// Proste ikony-placeholdery dla kafelków P1 (docelowo zdjęcia makro skóry).
const tileIcons: Record<string, string> = {
  "t-strefa": `<path d="M50 20v60" /><path d="M28 30h44" />`,
  "cala-twarz": `<circle cx="36" cy="34" r="2.5" fill="currentColor" stroke="none" /><circle cx="58" cy="30" r="2.5" fill="currentColor" stroke="none" /><circle cx="46" cy="48" r="2.5" fill="currentColor" stroke="none" /><circle cx="64" cy="52" r="2.5" fill="currentColor" stroke="none" /><circle cx="32" cy="58" r="2.5" fill="currentColor" stroke="none" />`,
  sciaga: `<path d="M26 34h20" /><path d="M30 46h26" /><path d="M26 58h20" /><path d="M54 34h20" /><path d="M60 58h14" />`,
  reaguje: `<circle cx="50" cy="44" r="6" /><path d="M50 26v10" /><path d="M50 52v10" /><path d="M30 44h10" /><path d="M60 44h10" />`,
  "trudno-powiedziec": `<path d="M42 38a8 8 0 1 1 12 7c-4 2-4 5-4 8" /><circle cx="50" cy="64" r="1.5" fill="currentColor" stroke="none" />`,
};
---

<Layout
  title="Karta Twojej Skóry"
  description="Odpowiedz na 7 pytań i otrzymaj wstępną Kartę Skóry: profil, priorytety pielęgnacji i rekomendowany program. To analiza wstępna — prawdziwą diagnozę wykonuję osobiście w gabinecie."
>
  <section class="pt-8 pb-4 md:pt-12">
    <div class="container-page">
      <p class="eyebrow mb-3">Karta Twojej Skóry</p>
      <h1 class="sr-only">Karta Twojej Skóry — kreator</h1>

      <div
        id="quiz-progress"
        class="flex items-center"
        role="progressbar"
        aria-valuemin="1"
        aria-valuemax={totalQuestions}
        aria-valuenow="1"
        aria-label={`Postęp: pytanie 1 z ${totalQuestions}`}
      >
        {quizQuestions.map((q, i) => (
          <span class="flex items-center">
            <span
              data-progress-dot
              data-index={i}
              class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border-2 border-pine/20 font-heading text-[11px] font-semibold text-ink-soft transition-colors sm:h-8 sm:w-8 sm:text-xs"
            >
              {q.number}
            </span>
            {i < quizQuestions.length - 1 && (
              <span class="h-px w-3 shrink-0 bg-pine/15 sm:w-6" aria-hidden="true"></span>
            )}
          </span>
        ))}
      </div>
    </div>
  </section>

  <section class="pb-32 md:pb-36">
    <div class="container-page max-w-2xl">
      <div id="quiz-live" class="sr-only" role="status" aria-live="polite"></div>

      {quizQuestions.map((q, i) => (
        <div class="quiz-step" data-step={i + 1} tabindex="-1" hidden={i !== 0}>
          <h2 class="font-heading text-2xl font-semibold text-ink md:text-3xl">{q.question}</h2>
          {q.subtitle && <p class="mt-2 text-sm text-ink-soft">{q.subtitle}</p>}

          {q.type === "slider" ? (
            <div class="mt-10">
              <input
                type="range"
                min="0"
                max={q.options.length - 1}
                step="1"
                value="2"
                data-quiz-slider
                data-question={q.id}
                aria-label={q.question}
                class="w-full accent-pine"
              />
              <div class="mt-4 flex items-start justify-between gap-2 text-xs text-ink-soft">
                <span class="max-w-[30%]">{q.options[0].label}</span>
                <span data-slider-current class="text-center font-heading text-sm font-semibold text-pine">
                  {q.options[2].label}
                </span>
                <span class="max-w-[30%] text-right">{q.options[q.options.length - 1].label}</span>
              </div>
            </div>
          ) : q.id === "p1" ? (
            <div class="mt-8 grid gap-3 sm:grid-cols-2" role="group" aria-label={q.question}>
              {q.options.map((opt) => (
                <button
                  type="button"
                  class="quiz-tile flex min-h-11 flex-col overflow-hidden rounded-xl border-2 border-pine/15 bg-porcelain text-left transition-colors hover:border-pine/50 aria-pressed:border-pine aria-pressed:bg-mist"
                  data-question={q.id}
                  data-value={opt.value}
                  data-type={q.type}
                  aria-pressed="false"
                >
                  <span
                    class="flex aspect-[4/3] w-full items-center justify-center bg-linear-to-br from-sage/25 via-mist to-porcelain"
                    aria-hidden="true"
                  >
                    <svg width="40" height="40" viewBox="0 0 100 100" fill="none" stroke="var(--color-pine)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.55" set:html={tileIcons[opt.value]} />
                  </span>
                  <span class="px-4 py-3 text-sm font-medium text-ink">{opt.label}</span>
                </button>
              ))}
            </div>
          ) : (
            <div
              class="mt-8 grid gap-3 sm:grid-cols-2"
              role="group"
              aria-label={q.question}
            >
              {q.options.map((opt) => (
                <button
                  type="button"
                  class="quiz-tile min-h-11 rounded-xl border-2 border-pine/15 bg-porcelain px-4 py-3 text-left text-sm text-ink transition-colors hover:border-pine/50 aria-pressed:border-pine aria-pressed:bg-mist"
                  data-question={q.id}
                  data-value={opt.value}
                  data-type={q.type}
                  aria-pressed="false"
                >
                  {opt.label}
                </button>
              ))}
            </div>
          )}
        </div>
      ))}

      <div class="quiz-step" data-step={resultStep} tabindex="-1" hidden id="quiz-result"></div>
    </div>
  </section>

  <div id="quiz-nav" class="fixed inset-x-0 bottom-0 z-40 border-t border-pine/12 bg-porcelain">
    <div class="container-page flex items-center justify-between gap-4 py-4">
      <button
        type="button"
        id="quiz-back"
        class="min-h-11 rounded-full border border-pine/20 px-5 py-2.5 font-heading text-sm font-semibold text-ink-soft transition-colors hover:border-pine hover:text-pine disabled:pointer-events-none disabled:opacity-0"
        disabled
      >
        Wstecz
      </button>
      <button
        type="button"
        id="quiz-next"
        class="min-h-11 rounded-full bg-pine px-6 py-2.5 font-heading text-sm font-semibold text-porcelain transition-colors hover:bg-ink disabled:opacity-40"
        disabled
      >
        Dalej
      </button>
    </div>
  </div>
</Layout>

<style>
  @media print {
    :global(header),
    :global(footer),
    :global(#diagnosis-bar),
    #quiz-nav,
    #quiz-progress,
    #quiz-live {
      display: none !important;
    }
    .quiz-step {
      display: none !important;
    }
    #quiz-result {
      display: block !important;
    }
  }
</style>

<script>
  import { quizQuestions, computeResult, HONESTY_CLOSING, type QuizAnswers } from "../data/skinQuiz";
  import { programs } from "../data/programs";

  const steps = Array.from(document.querySelectorAll<HTMLElement>(".quiz-step"));
  const totalQuestions = quizQuestions.length;
  const resultStepNumber = totalQuestions + 1;

  const backBtn = document.getElementById("quiz-back") as HTMLButtonElement | null;
  const nextBtn = document.getElementById("quiz-next") as HTMLButtonElement | null;
  const liveRegion = document.getElementById("quiz-live");
  const progressBar = document.getElementById("quiz-progress");
  const progressDots = Array.from(document.querySelectorAll<HTMLElement>("[data-progress-dot]"));
  const resultContainer = document.getElementById("quiz-result");

  if (!backBtn || !nextBtn || !resultContainer) throw new Error("Karta skóry: brak elementów kreatora");

  // Stan tylko w pamięci JS (bez localStorage/sessionStorage) — znika przy odświeżeniu.
  const answers: QuizAnswers = { p2: [] };
  let current = 1;

  function isAnswered(questionId: string): boolean {
    const q = quizQuestions.find((qq) => qq.id === questionId);
    if (!q) return false;
    if (q.type === "multi") return (answers[q.id as "p2"] ?? []).length > 0;
    return (answers as Record<string, unknown>)[q.id] !== undefined;
  }

  function updateNextState() {
    if (current > totalQuestions) return;
    const q = quizQuestions[current - 1];
    nextBtn!.disabled = !isAnswered(q.id);
  }

  function showStep(step: number, opts: { focus?: boolean } = {}) {
    const { focus = true } = opts;
    steps.forEach((el) => {
      el.hidden = Number(el.dataset.step) !== step;
    });
    current = step;
    backBtn!.disabled = step === 1;

    if (step <= totalQuestions) {
      progressBar?.setAttribute("aria-valuenow", String(step));
      progressBar?.setAttribute("aria-label", `Postęp: pytanie ${step} z ${totalQuestions}`);
      progressDots.forEach((dot, i) => {
        dot.classList.toggle("bg-pine", i < step);
        dot.classList.toggle("border-pine", i < step);
        dot.classList.toggle("text-porcelain", i < step);
      });
      nextBtn!.hidden = false;
      nextBtn!.textContent = step === totalQuestions ? "Zobacz Kartę" : "Dalej";
      updateNextState();
    } else {
      nextBtn!.hidden = true;
    }

    if (focus) {
      steps.find((el) => Number(el.dataset.step) === step)?.focus();
    }

    if (liveRegion) {
      liveRegion.textContent =
        step <= totalQuestions ? `Pytanie ${step} z ${totalQuestions}` : "Twoja Karta Skóry jest gotowa";
    }
  }

  function selectSingle(questionId: string, value: string, tile: HTMLElement) {
    (answers as Record<string, unknown>)[questionId] = value;
    document.querySelectorAll<HTMLElement>(`[data-question="${questionId}"]`).forEach((el) => {
      el.setAttribute("aria-pressed", String(el === tile));
    });
    updateNextState();
  }

  function toggleMulti(questionId: string, value: string, tile: HTMLElement, max: number) {
    const list = (answers as Record<string, string[]>)[questionId] ?? ((answers as Record<string, string[]>)[questionId] = []);
    const idx = list.indexOf(value);
    if (idx >= 0) {
      list.splice(idx, 1);
      tile.setAttribute("aria-pressed", "false");
    } else {
      if (list.length >= max) return;
      list.push(value);
      tile.setAttribute("aria-pressed", "true");
    }
    updateNextState();
  }

  document.querySelectorAll<HTMLButtonElement>(".quiz-tile").forEach((tile) => {
    tile.addEventListener("click", () => {
      const questionId = tile.dataset.question!;
      const value = tile.dataset.value!;
      if (tile.dataset.type === "multi") {
        const question = quizQuestions.find((q) => q.id === questionId)!;
        toggleMulti(questionId, value, tile, question.maxSelections ?? 2);
      } else {
        selectSingle(questionId, value, tile);
      }
    });
  });

  document.querySelectorAll<HTMLInputElement>("[data-quiz-slider]").forEach((slider) => {
    const questionId = slider.dataset.question! as "p3";
    const question = quizQuestions.find((q) => q.id === questionId)!;
    const currentLabel = slider.parentElement?.querySelector<HTMLElement>("[data-slider-current]");
    const initialIndex = Number(slider.value);
    answers[questionId] = initialIndex;
    slider.setAttribute("aria-valuetext", question.options[initialIndex].label);

    slider.addEventListener("input", () => {
      const idx = Number(slider.value);
      answers[questionId] = idx;
      slider.setAttribute("aria-valuetext", question.options[idx].label);
      if (currentLabel) currentLabel.textContent = question.options[idx].label;
      updateNextState();
    });
  });

  backBtn.addEventListener("click", () => {
    if (current > 1) showStep(current - 1);
  });

  nextBtn.addEventListener("click", () => {
    if (current < totalQuestions) {
      showStep(current + 1);
    } else if (current === totalQuestions) {
      resultContainer.innerHTML = buildResultHTML();
      showStep(resultStepNumber);
    }
  });

  function escapeHtml(value: string): string {
    const div = document.createElement("div");
    div.textContent = value;
    return div.innerHTML;
  }

  function priorityBadge(label: string): string {
    return `<span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-pine font-heading text-sm font-semibold text-porcelain" aria-hidden="true">${label}</span>`;
  }

  function buildResultHTML(): string {
    const result = computeResult(answers);
    const program = programs.find((p) => p.slug === result.programSlug);
    const today = new Date().toLocaleDateString("pl-PL", { day: "numeric", month: "long", year: "numeric" });

    const prioritiesHtml = result.priorities
      .map(
        (p, i) => `
        <div class="flex gap-4">
          ${priorityBadge(String(i + 1).padStart(2, "0"))}
          <div>
            <p class="font-heading font-semibold text-ink">${escapeHtml(p.title)}</p>
            <p class="mt-1 text-sm leading-relaxed text-ink-soft">${escapeHtml(p.reason)}</p>
          </div>
        </div>`
      )
      .join("");

    const avoidHtml = result.avoid
      .map(
        (a) =>
          `<li class="flex items-start gap-2 text-sm leading-relaxed text-ink"><span class="mt-0.5 text-pine" aria-hidden="true">·</span><span>${escapeHtml(a)}</span></li>`
      )
      .join("");

    const homeCareHtml = result.homeCare
      .map(
        (h, i) => `
        <li class="flex items-start gap-3 text-sm leading-relaxed text-ink">
          <span class="mt-0.5 shrink-0 font-heading font-semibold text-pine">${i + 1}.</span>
          <span>${escapeHtml(h)}</span>
        </li>`
      )
      .join("");

    const programHtml = program
      ? `
      <div class="mt-10">
        <p class="eyebrow mb-4">Rekomendowany program</p>
        <a href="/programy/${program.slug}" class="block rounded-2xl bg-pine p-6 text-porcelain transition-colors hover:bg-ink md:p-7">
          <p class="font-heading text-xl font-semibold">${escapeHtml(program.name)}</p>
          <p class="mt-1 text-sm text-porcelain/80">${escapeHtml(program.forWhom)}</p>
          <p class="mt-3 text-sm text-porcelain/90">
            ${
              program.visits && program.durationMonths && program.packagePrice
                ? `${program.visits} wizyt · ${program.durationMonths} mies. · od ${program.packagePrice.toLocaleString("pl-PL")} zł`
                : "Plan wizyt i wycena ustalane indywidualnie, po diagnozie"
            }
          </p>
          <span class="mt-4 inline-flex items-center gap-1.5 font-heading text-sm font-semibold">Zobacz program →</span>
        </a>
        ${result.programExplanation ? `<p class="mt-3 text-sm leading-relaxed text-ink-soft">${escapeHtml(result.programExplanation)}</p>` : ""}
      </div>`
      : "";

    return `
      <article class="rounded-2xl border border-pine/12 bg-porcelain p-6 md:p-10" id="skin-card">
        <div class="border-b border-pine/12 pb-6">
          <p class="eyebrow mb-2">Karta Twojej Skóry</p>
          <p class="text-xs text-ink-soft">${today}</p>
        </div>

        <div class="mt-8">
          <p class="eyebrow mb-2">Profil skóry</p>
          <h2 class="font-heading text-3xl font-semibold text-ink md:text-4xl">${escapeHtml(result.profileLabel)}</h2>
          <p class="mt-3 max-w-xl leading-relaxed text-ink-soft">${escapeHtml(result.profileExplanation)}</p>
        </div>

        <div class="mt-10">
          <p class="eyebrow mb-4">Trzy priorytety</p>
          <div class="space-y-6">${prioritiesHtml}</div>
        </div>

        <div class="mt-10 rounded-xl bg-mist p-5">
          <p class="font-heading text-sm font-semibold uppercase tracking-wider text-ink-soft">Czego jeszcze nie robić</p>
          <ul class="mt-3 space-y-2">${avoidHtml}</ul>
        </div>

        ${programHtml}

        <div class="mt-10">
          <p class="eyebrow mb-4">Co możesz zrobić od jutra</p>
          <ul class="space-y-3">${homeCareHtml}</ul>
        </div>

        <div class="mt-10">
          <p class="eyebrow mb-2">Właściwy moment</p>
          <p class="text-sm leading-relaxed text-ink-soft">${escapeHtml(result.seasonality)}</p>
        </div>

        <div class="mt-10 rounded-xl border border-sage/60 p-5">
          <p class="italic leading-relaxed text-ink">${escapeHtml(HONESTY_CLOSING)}</p>
          <p class="mt-3 text-xs text-ink-soft">Karta ma charakter informacyjny i nie stanowi porady medycznej.</p>
        </div>

        <div class="mt-10 border-t border-pine/12 pt-6 text-right">
          <p class="font-heading italic text-pine">mgr Nina Halicka</p>
        </div>
      </article>

      <div class="mt-8 flex flex-col items-center gap-3 print:hidden">
        <a
          href="/kontakt?cel=diagnoza${program ? `&program=${program.slug}` : ""}"
          class="inline-flex min-h-11 items-center justify-center rounded-full bg-pine px-6 py-3 font-heading text-sm font-semibold text-porcelain transition-colors hover:bg-ink"
        >
          Umów diagnozę — 200 zł, odliczane od programu
        </a>
        <button
          type="button"
          onclick="window.print()"
          class="inline-flex min-h-11 items-center justify-center rounded-full border border-pine/20 px-6 py-3 font-heading text-sm font-semibold text-ink-soft transition-colors hover:border-pine hover:text-pine"
        >
          Zapisz lub wydrukuj Kartę
        </button>
      </div>
    `;
  }

  showStep(1, { focus: false });
</script>

---
import Layout from "../layouts/Layout.astro";
import Ring from "../components/Ring.astro";

const steps = [
  { title: "Wywiad", text: "Rozmawiamy o Twojej skórze, nawykach pielęgnacyjnych i oczekiwaniach." },
  { title: "Analiza skóry aparatem", text: "Sprawdzam stan skóry urządzeniem diagnostycznym — nawilżenie, przebarwienia, stan porów." },
  { title: "Omówienie", text: "Tłumaczę, co widzę i co to oznacza dla Twojej skóry, bez żargonu." },
  { title: "Plan na piśmie", text: "Dostajesz konkretny plan: program albo pojedyncze zabiegi, z cenami i harmonogramem." },
];

const faq = [
  {
    question: "Czy diagnoza do czegoś mnie zobowiązuje?",
    answer: "Nie. Po diagnozie dostajesz plan na piśmie — decyzję, czy i kiedy zacząć program, podejmujesz Ty.",
  },
  {
    question: "Czy 200 zł to dodatkowy koszt oprócz programu?",
    answer: "Nie — jeśli zdecydujesz się na program lub zabieg, całe 200 zł jest odliczane od jego ceny.",
  },
  {
    question: "Jak przygotować się do diagnozy?",
    answer: "Przyjdź bez makijażu lub z lekkim makijażem — ułatwi to dokładną analizę skóry aparatem.",
  },
];
---

<Layout
  title="Diagnoza skóry"
  description="Diagnoza skóry HALICKA — 40 minut, 200 zł w całości odliczane od pierwszego programu lub zabiegu. Początek każdej współpracy."
>
  <section class="pt-14 pb-12 md:pt-20 md:pb-16">
    <div class="container-page">
      <p class="eyebrow mb-4">Diagnoza skóry</p>
      <h1 class="max-w-2xl font-heading text-4xl font-semibold text-ink md:text-5xl">
        Diagnoza skóry — początek każdej współpracy
      </h1>
      <p class="mt-6 max-w-xl leading-relaxed text-ink-soft">
        Zanim zaproponuję Ci program albo zabieg, chcę dokładnie poznać Twoją skórę. Diagnoza to nie
        formalność — to 40 minut, po których wiesz dokładnie, na czym stoisz i co dalej.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-x-10 gap-y-4 border-y border-pine/12 py-6">
        <div>
          <p class="font-heading text-xs font-semibold uppercase tracking-wider text-ink-soft">Czas</p>
          <p class="mt-1 font-heading text-lg font-semibold text-ink">40 min</p>
        </div>
        <div>
          <p class="font-heading text-xs font-semibold uppercase tracking-wider text-ink-soft">Cena</p>
          <p class="mt-1 font-heading text-lg font-semibold text-ink">200 zł</p>
        </div>
        <div>
          <p class="font-heading text-xs font-semibold uppercase tracking-wider text-ink-soft">Ważne</p>
          <p class="mt-1 font-heading text-lg font-semibold text-pine">W całości odliczane od programu</p>
        </div>
      </div>

      <a
        href="/kontakt"
        class="mt-8 inline-flex items-center rounded-full bg-pine px-6 py-3 font-heading text-sm font-semibold text-porcelain transition-colors hover:bg-ink"
      >
        Umów diagnozę
      </a>
    </div>
  </section>

  <section class="border-t border-pine/12 py-16 md:py-20">
    <div class="container-page">
      <p class="eyebrow mb-4">Przebieg</p>
      <h2 class="max-w-xl font-heading text-2xl font-semibold text-ink md:text-3xl">Jak wygląda diagnoza</h2>

      <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {steps.map((step, i) => (
          <div class="flex flex-col gap-4">
            <Ring size={48} label={String(i + 1)} />
            <div>
              <p class="font-heading font-semibold text-ink">{step.title}</p>
              <p class="mt-2 text-sm leading-relaxed text-ink-soft">{step.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-pine/12 py-16 md:py-20">
    <div class="container-page">
      <p class="eyebrow mb-4">Uczciwość</p>
      <h2 class="max-w-xl font-heading text-2xl font-semibold text-ink md:text-3xl">
        Czasem najlepszą radą jest inny gabinet
      </h2>

      <div class="mt-8 max-w-2xl rounded-2xl border border-sage/60 p-6 md:p-7">
        <p class="italic leading-relaxed text-ink">
          „Jeśli Twoja skóra potrzebuje dermatologa, nie kosmetologa — powiem to wprost i wskażę,
          do kogo iść. Wolę stracić jedną wizytę, niż prowadzić Cię w złym kierunku.”
        </p>
      </div>
    </div>
  </section>

  <section class="border-t border-pine/12 py-16 md:py-20">
    <div class="container-page">
      <p class="eyebrow mb-4">Pytania</p>
      <h2 class="max-w-xl font-heading text-2xl font-semibold text-ink md:text-3xl">Najczęstsze pytania</h2>

      <div class="mt-10 max-w-2xl divide-y divide-mist">
        {faq.map((item) => (
          <div class="py-6">
            <p class="font-heading font-semibold text-ink">{item.question}</p>
            <p class="mt-2 text-sm leading-relaxed text-ink-soft">{item.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-pine text-porcelain">
    <div class="container-page py-16 text-center md:py-20">
      <h2 class="font-heading text-2xl font-semibold md:text-4xl">Zacznijmy od diagnozy.</h2>
      <p class="mt-4 max-w-lg mx-auto text-porcelain/85">
        200 zł, 40 minut i plan, który wiesz skąd się wziął.
      </p>
      <a
        href="/kontakt"
        class="mt-8 inline-flex items-center rounded-full bg-porcelain px-6 py-3 font-heading text-sm font-semibold text-pine transition-colors hover:bg-mist"
      >
        Umów diagnozę
      </a>
    </div>
  </section>
</Layout>

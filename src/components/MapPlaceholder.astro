---
// Stylizowany placeholder mapy — adres gabinetu zawsze Gdańsk-Wrzeszcz,
// bez pinezki (patrz sekcja 11 specyfikacji: "bez fałszywej pinezki lokalu").
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["relative aspect-[4/3] w-full overflow-hidden rounded-2xl border border-pine/10 bg-mist", className]}>
  <svg class="absolute inset-0 h-full w-full text-pine/15" viewBox="0 0 200 150" preserveAspectRatio="none" aria-hidden="true">
    <line x1="0" y1="35" x2="200" y2="30" stroke="currentColor" stroke-width="1.5" />
    <line x1="0" y1="95" x2="200" y2="105" stroke="currentColor" stroke-width="1.5" />
    <line x1="45" y1="0" x2="55" y2="150" stroke="currentColor" stroke-width="1.5" />
    <line x1="140" y1="0" x2="130" y2="150" stroke="currentColor" stroke-width="1.5" />
  </svg>
  <p class="absolute bottom-3 left-3 font-heading text-xs font-semibold uppercase tracking-wider text-ink-soft">
    Gdańsk-Wrzeszcz
  </p>
</div>

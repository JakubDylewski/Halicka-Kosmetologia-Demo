---
import { formatPrice, type Program } from "../data/programs";

interface Props {
  program: Program;
}

const { program } = Astro.props;
const isIndividual = program.packagePrice === null;
---

<a
  href={`/programy/${program.slug}`}
  class="group block rounded-2xl bg-mist p-6 md:p-7 transition-colors hover:bg-sage/25"
>
  <p class="font-heading text-lg font-semibold text-ink">{program.name}</p>
  <p class="mt-2 text-sm text-ink-soft leading-relaxed">{program.forWhom}</p>

  <p class="mt-5 text-xs font-heading font-semibold uppercase tracking-wider text-pine">
    {isIndividual ? "Program indywidualny" : `${program.visits} wizyt · ${program.durationMonths} mies.`}
  </p>

  <div class="mt-3 flex items-baseline gap-2">
    {isIndividual ? (
      <span class="font-heading text-2xl font-semibold text-ink">Indywidualnie</span>
    ) : (
      <>
        <span class="font-heading text-2xl font-semibold text-ink">{formatPrice(program.packagePrice!)}</span>
        <span class="text-sm text-ink-soft line-through decoration-ink-soft/60">
          {formatPrice(program.singlePrice!)}
        </span>
      </>
    )}
  </div>

  <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-heading font-semibold text-pine">
    Zobacz program
    <span class="transition-transform group-hover:translate-x-0.5">→</span>
  </span>
</a>

---
const currentPath = Astro.url.pathname;
const isHome = currentPath === "/";
const isContact = currentPath === "/kontakt";
---

{!isContact && (
  <a
    href="/kontakt"
    id="floating-cta"
    class="fixed bottom-6 right-5 z-50 inline-flex items-center rounded-full bg-pine text-porcelain px-5 py-3 font-heading text-sm font-semibold shadow-lg shadow-ink/15 opacity-0 translate-y-2 pointer-events-none transition-all duration-300 hover:bg-ink"
  >
    Umów diagnozę
  </a>
)}

{!isHome && (
  <a
    href="/"
    id="floating-home"
    class="floating-home hidden lg:inline-flex fixed bottom-6 left-5 z-50 items-center rounded-full bg-porcelain text-pine border border-sage/60 px-5 py-3 font-heading text-sm font-semibold shadow-md shadow-ink/10 hover:bg-mist transition-colors"
  >
    Strona główna
  </a>
)}

<style>
  @keyframes breathe {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-3px);
    }
  }

  .floating-home {
    animation: breathe 3.2s ease-in-out infinite;
  }
</style>

<script>
  const cta = document.getElementById("floating-cta");

  if (cta) {
    const reveal = () => {
      const show = window.scrollY > 400;
      cta.classList.toggle("opacity-0", !show);
      cta.classList.toggle("pointer-events-none", !show);
      cta.classList.toggle("translate-y-2", !show);
    };

    reveal();
    window.addEventListener("scroll", reveal, { passive: true });
  }
</script>

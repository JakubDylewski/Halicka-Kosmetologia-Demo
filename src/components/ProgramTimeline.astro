---
// Oś czasu programu.
// Desktop: pozioma, przewijana przy wielu wizytach. Mobile: pionowa.
// 12.3: scroll-linked, odwracalne. Linia postępu rośnie (transform: scale,
// nie width — bez wpływu na layout), punkty aktywują się kolejno (wypełnienie
// pierścienia przez .is-active, patrz global.css). Napędzane wspólnym
// 'app:scroll' z ScrollBus.astro, nie własnym listenerem.

import Ring from "./Ring.astro";
import type { ProgramVisit } from "../data/programs";

interface Props {
  visits: ProgramVisit[];
}

const { visits } = Astro.props;
---

<div class="tl-root" data-timeline data-count={visits.length}>
  <div class="hidden md:block overflow-x-auto pb-2 -mx-1 px-1">
    <div class="relative flex gap-10 min-w-max">
      <div class="absolute left-0 right-0 top-[27px] h-px bg-pine/15" aria-hidden="true"></div>
      <div class="tl-progress-h absolute left-0 top-[27px] h-px w-full origin-left scale-x-0 bg-pine" aria-hidden="true"></div>
      {visits.map((visit, i) => (
        <div class="relative flex w-64 shrink-0 flex-col gap-4" data-timeline-point data-index={i}>
          <Ring size={56} label={String(visit.number)} class="rounded-full bg-porcelain" />
          <div>
            <p class="font-heading font-semibold leading-snug text-ink">{visit.title}</p>
            <p class="mt-2 text-sm leading-relaxed text-ink-soft">{visit.note}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="relative flex flex-col gap-8 pl-1 md:hidden">
    <div class="absolute bottom-2 left-[27px] top-2 w-px bg-pine/15" aria-hidden="true"></div>
    <div class="tl-progress-v absolute left-[27px] top-2 bottom-2 w-px origin-top scale-y-0 bg-pine" aria-hidden="true"></div>
    {visits.map((visit, i) => (
      <div class="relative flex gap-4" data-timeline-point data-index={i}>
        <Ring size={56} label={String(visit.number)} class="relative z-10 shrink-0 rounded-full bg-porcelain" />
        <div class="pt-2.5">
          <p class="font-heading font-semibold leading-snug text-ink">{visit.title}</p>
          <p class="mt-2 text-sm leading-relaxed text-ink-soft">{visit.note}</p>
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .tl-progress-h,
  .tl-progress-v {
    transition: transform 150ms linear;
  }

  @media (prefers-reduced-motion: reduce) {
    .tl-progress-h,
    .tl-progress-v {
      transform: scale(1) !important;
      transition: none;
    }
  }
</style>

<script>
  const roots = document.querySelectorAll<HTMLElement>("[data-timeline]");

  roots.forEach((root) => {
    const count = Number(root.dataset.count ?? "1");
    const points = Array.from(root.querySelectorAll<HTMLElement>("[data-timeline-point]"));
    const progressH = root.querySelector<HTMLElement>(".tl-progress-h");
    const progressV = root.querySelector<HTMLElement>(".tl-progress-v");

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const applyProgress = (progress: number) => {
      progressH?.style.setProperty("transform", `scaleX(${progress})`);
      progressV?.style.setProperty("transform", `scaleY(${progress})`);

      points.forEach((point) => {
        const index = Number(point.dataset.index ?? "0");
        const threshold = count > 1 ? index / count : 0;
        point.querySelector(".ring-signature")?.classList.toggle("is-active", progress >= threshold);
      });
    };

    if (reducedMotion) {
      applyProgress(1);
      return;
    }

    const update = () => {
      const rect = root.getBoundingClientRect();
      const triggerLine = window.innerHeight * 0.75;
      const raw = (triggerLine - rect.top) / Math.max(rect.height, 1);
      applyProgress(Math.min(1, Math.max(0, raw)));
    };

    update();
    window.addEventListener("app:scroll", update);
    window.addEventListener("resize", update, { passive: true });
  });
</script>

---
import Ring from "./Ring.astro";

const navItems = [
  { label: "Strona główna", href: "/" },
  { label: "Karta skóry", href: "/karta-skory" },
  { label: "Programy", href: "/programy" },
  { label: "Zabiegi", href: "/zabiegi" },
  { label: "Diagnoza skóry", href: "/diagnoza-skory" },
  { label: "Efekty", href: "/efekty" },
  { label: "O mnie", href: "/o-mnie" },
  { label: "Kontakt", href: "/kontakt" },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? currentPath === "/" : currentPath.startsWith(href));
---

<header id="site-header" class="sticky top-0 z-40 bg-porcelain border-b border-pine/12 transition-shadow duration-200">
  <div class="container-page flex items-center justify-between h-[72px]">
    <a href="/" class="flex items-center gap-2 shrink-0 font-heading text-pine sm:gap-3">
      <Ring size={28} ticks={12} class="sm:hidden" />
      <Ring size={32} ticks={12} class="hidden sm:block" />
      <span class="whitespace-nowrap">
        <span class="text-sm font-semibold sm:text-lg">HALICKA</span>
        <span class="text-[10px] font-medium text-ink-soft sm:text-xs"> Kosmetologia</span>
      </span>
    </a>

    <nav class="hidden lg:flex items-center gap-7 font-heading text-sm">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            "transition-colors hover:text-pine",
            isActive(item.href) ? "text-pine font-semibold" : "text-ink-soft",
          ]}
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden lg:flex items-center gap-6 shrink-0">
      <a href="tel:+48512340220" class="font-sans text-sm text-ink hover:text-pine transition-colors">
        512 340 220
      </a>
      <a
        href="/kontakt"
        class="inline-flex items-center rounded-full bg-pine text-porcelain px-5 py-2.5 font-heading text-sm font-semibold hover:bg-ink transition-colors"
      >
        Umów diagnozę
      </a>
    </div>

    <div class="flex items-center gap-2 lg:hidden">
      <a
        href="tel:+48512340220"
        aria-label="Zadzwoń: 512 340 220"
        class="inline-flex items-center justify-center w-10 h-10 text-pine"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 5c0-1.1.9-2 2-2h2.28a1 1 0 0 1 .97.76l1.1 4.36a1 1 0 0 1-.5 1.13l-2 1.15a12.5 12.5 0 0 0 6.75 6.75l1.15-2a1 1 0 0 1 1.13-.5l4.36 1.1a1 1 0 0 1 .76.97V19c0 1.1-.9 2-2 2h-1C9.6 21 3 14.4 3 6V5Z" />
        </svg>
      </a>
      <button
        id="menu-toggle"
        type="button"
        class="inline-flex flex-col items-center justify-center gap-1.5 w-10 h-10"
        aria-label="Otwórz menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="menu-bar block h-0.5 w-6 bg-pine transition-transform"></span>
        <span class="menu-bar block h-0.5 w-6 bg-pine transition-opacity"></span>
        <span class="menu-bar block h-0.5 w-6 bg-pine transition-transform"></span>
      </button>
    </div>
  </div>
</header>

<dialog id="mobile-menu" class="mobile-menu-dialog lg:hidden">
  <div class="flex h-full flex-col">
    <div class="container-page flex items-center justify-between h-[72px] shrink-0">
      <a href="/" class="flex items-center gap-2 font-heading text-pine">
        <Ring size={28} ticks={12} />
        <span class="whitespace-nowrap">
          <span class="text-sm font-semibold">HALICKA</span>
          <span class="text-[10px] font-medium text-ink-soft"> Kosmetologia</span>
        </span>
      </a>
      <button
        id="menu-close"
        type="button"
        aria-label="Zamknij menu"
        class="inline-flex items-center justify-center w-10 h-10 text-pine"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" />
        </svg>
      </button>
    </div>

    <nav class="container-page flex-1 overflow-y-auto flex flex-col justify-center font-heading">
      {navItems.map((item, i) => (
        <a
          href={item.href}
          class:list={[
            "flex items-center gap-4 py-4 border-b border-pine/12 last:border-none transition-colors active:bg-mist",
            isActive(item.href) ? "text-pine" : "text-ink",
          ]}
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          <Ring size={32} label={String(i + 1).padStart(2, "0")} class="shrink-0" />
          <span class:list={["text-2xl", isActive(item.href) && "font-semibold"]}>{item.label}</span>
        </a>
      ))}
    </nav>

    <div class="container-page pb-10 pt-4 flex flex-col gap-4 shrink-0">
      <a href="tel:+48512340220" class="font-sans text-base text-ink-soft">
        512 340 220
      </a>
      <a
        href="/kontakt"
        class="inline-flex items-center justify-center rounded-full bg-pine text-porcelain px-5 py-3 font-heading text-sm font-semibold"
      >
        Umów diagnozę
      </a>
    </div>
  </div>
</dialog>

<style>
  .mobile-menu-dialog {
    margin: 0;
    padding: 0;
    border: none;
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    background-color: var(--color-porcelain);
  }

  .mobile-menu-dialog::backdrop {
    background-color: transparent;
  }
</style>

<script>
  const header = document.getElementById("site-header");
  const toggle = document.getElementById("menu-toggle");
  const closeBtn = document.getElementById("menu-close");
  const menu = document.getElementById("mobile-menu") as HTMLDialogElement | null;

  if (menu) {
    // 16.2 — natywny <dialog> daje focus trap i zamykanie Escape za darmo.
    // Reset paddingu ciała strony wywołujemy też synchronicznie w keydown
    // (lekcja z DemoNoticeModal: zdarzenie 'close' bywa opóźnione w niektórych
    // środowiskach), nie tylko przez listener 'close'.
    const resetBody = () => {
      document.body.style.overflow = "";
    };

    const openMenu = () => {
      menu.showModal();
      document.body.style.overflow = "hidden";
      toggle?.setAttribute("aria-expanded", "true");
    };

    const closeMenu = () => {
      resetBody();
      menu.close();
    };

    menu.addEventListener("close", () => {
      resetBody();
      toggle?.setAttribute("aria-expanded", "false");
    });

    menu.addEventListener("keydown", (e) => {
      if (e.key === "Escape") resetBody();
    });

    toggle?.addEventListener("click", openMenu);
    closeBtn?.addEventListener("click", closeMenu);
  }

  if (header) {
    const onScroll = (scrollY: number) => {
      header.classList.toggle("shadow-[0_1px_16px_rgba(33,38,35,0.08)]", scrollY > 4);
    };
    onScroll(window.scrollY);
    window.addEventListener("app:scroll", (e) => onScroll((e as CustomEvent<{ scrollY: number }>).detail.scrollY));
  }
</script>

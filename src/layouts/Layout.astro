---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import DiagnosisBar from "../components/DiagnosisBar.astro";
import ScrollBus from "../components/ScrollBus.astro";
import MotionObserver from "../components/MotionObserver.astro";

interface Props {
  title: string;
  description?: string;
  robots?: string;
}

const {
  title,
  description = "HALICKA — Kosmetologia Estetyczna. Gdańsk-Wrzeszcz. Twoja skóra ma plan.",
  robots = "index, follow",
} = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <title>{title} · HALICKA Kosmetologia Estetyczna</title>
    <slot name="head" />
  </head>
  <body class="font-sans antialiased">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <DiagnosisBar />
    <ScrollBus />
    <MotionObserver />
  </body>
</html>
